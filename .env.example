# ==============================================================
# BALIWASTE (Bali Waste Intelligence System)
# Environment Variables Template
# PENTING: JANGAN PERNAH MENYIMPAN NILAI RAHASIA / ASLI DI SINI!
# Copy file ini menjadi .env.local untuk development lokal
# ==============================================================

# Database (Supabase PostgreSQL Connection String)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key_generate_with_openssl_or_uuid

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (Media / Waste Photo Upload)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# App Environment
NODE_ENV=development
PORT=3000
